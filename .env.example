# Copy to .env for local development. Every value has a default except the API key.

# Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://triage:triage@localhost:5432/triage
# Used by the test suite and offline evals. These TRUNCATE tables: use a throwaway database.
TEST_DATABASE_URL=postgresql+asyncpg://triage:triage@localhost:5432/triage_test

# Claude API. Without a key the service runs, but POST /incidents/{id}/triage fails.
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-sonnet-5-5

# Agent guardrails
AGENT_MAX_ITERATIONS=8
AGENT_TOKEN_BUDGET=60000
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_TOKENS_PER_CALL=2048
TOOL_OUTPUT_MAX_CHARS=12000

# LLM transport
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=8

# Ingestion
DEDUP_WINDOW_SECONDS=600
GROUP_WINDOW_SECONDS=1800

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
